<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= @selected_event.name %> 海外超抜</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 28px; color: #1f2937; font-family: "Hiragino Sans", "Yu Gothic", sans-serif; }
      h1 { margin: 0 0 8px; font-size: 26px; }
      p { margin: 0 0 20px; color: #4b5563; }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      th, td { min-height: 42px; padding: 10px 12px; border: 1.5px solid #374151; vertical-align: middle; word-break: break-word; }
      th { background: #f3f4f6; font-weight: 700; text-align: left; }
      thead th { text-align: center; }
      th:nth-child(1) { width: 15%; }
      th:nth-child(2) { width: 45%; }
      th:nth-child(3) { width: 40%; }
      .number { text-align: right; font-variant-numeric: tabular-nums; }
    </style>
  </head>
  <body>
    <h1>海外超抜</h1>
    <p><%= @selected_event.name %></p>
    <table>
      <thead><tr><th>番号</th><th>引保師名</th><th>備考</th></tr></thead>
      <tbody>
        <% @export_entries.each do |entry| %>
          <tr>
            <td class="number"><%= number_with_delimiter(entry.serial_number) %></td>
            <td><%= entry.assistant_name %></td>
            <td><%= entry.notes.presence || "" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </body>
</html>
