<% content_for :title, "海外超抜" %>

<div class="page-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Overseas Chobatsu</p>
      <h1>海外超抜</h1>
      <p class="page-context">対象超抜式: <strong><%= @selected_event.name %></strong></p>
    </div>
    <%= link_to "PDFダウンロード", export_overseas_chobatsu_entries_path(event_id: @selected_event.id), class: "button-secondary compact-button" %>
  </header>

  <% if flash[:notice].present? %>
    <div class="flash flash-notice"><%= flash[:notice] %></div>
  <% end %>
  <% if @entry_errors.present? %>
    <div class="flash flash-alert"><%= @entry_errors.to_sentence %></div>
  <% end %>

  <section class="panel overseas-chobatsu-panel">
    <div class="overseas-chobatsu-toolbar">
      <%= form_with url: overseas_chobatsu_entries_path, method: :get, class: "region-filter-form" do |form| %>
        <div class="field">
          <%= form.label :event_id, "超抜式" %>
          <%= form.collection_select :event_id, @events, :id, :name, { selected: @selected_event.id }, { onchange: "this.form.requestSubmit()" } %>
        </div>
      <% end %>
      <% if current_user.admin? %>
        <%= form_with url: overseas_chobatsu_entries_path, method: :get, class: "region-filter-form" do |form| %>
          <%= form.hidden_field :event_id, value: @selected_event.id %>
          <div class="field">
            <%= form.label :fellowship_id, "入力する伝道会" %>
            <%= form.collection_select :fellowship_id, @fellowships, :id, :name, { selected: @editing_fellowship&.id }, { onchange: "this.form.requestSubmit()" } %>
          </div>
        <% end %>
      <% end %>
      <p>番号と海外超抜引保師名を入力してください。</p>
    </div>

    <%= form_with url: bulk_update_overseas_chobatsu_entries_path(event_id: @selected_event.id, fellowship_id: @editing_fellowship&.id), method: :patch, class: "overseas-chobatsu-form", data: { overseas_entries: true, overseas_entry_index: @entries.length } do %>
      <div class="overseas-chobatsu-table-wrapper">
        <table class="overseas-chobatsu-table">
          <thead>
            <tr>
              <th>番号</th>
              <th>引保師名</th>
              <th>備考</th>
              <th class="overseas-chobatsu-table__action">操作</th>
            </tr>
          </thead>
          <tbody>
            <% @entries.each do |entry| %>
              <tr data-overseas-entry-row data-overseas-entry-id="<%= entry.id %>">
                <td class="overseas-chobatsu-table__number">
                  <%= number_field_tag "entries[#{entry.id}][serial_number]", entry.serial_number, min: 1, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true }, aria: { label: "番号" } %>
                </td>
                <td>
                  <%= text_field_tag "entries[#{entry.id}][assistant_name]", entry.assistant_name, autocomplete: "off", aria: { label: "引保師名" } %>
                </td>
                <td>
                  <%= text_area_tag "entries[#{entry.id}][notes]", entry.notes, rows: 2, aria: { label: "備考" } %>
                </td>
                <td class="overseas-chobatsu-table__action"><button type="button" class="button-danger" data-remove-overseas-entry>行を削除</button></td>
              </tr>
            <% end %>
            <tr data-overseas-entry-row>
              <td class="overseas-chobatsu-table__number"><%= number_field_tag "entries[new-#{@entries.length}][serial_number]", nil, min: 1, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true }, aria: { label: "番号" } %></td>
              <td><%= text_field_tag "entries[new-#{@entries.length}][assistant_name]", nil, autocomplete: "off", aria: { label: "引保師名" } %></td>
              <td><%= text_area_tag "entries[new-#{@entries.length}][notes]", nil, rows: 2, aria: { label: "備考" } %></td>
              <td class="overseas-chobatsu-table__action"><button type="button" class="button-danger" data-remove-overseas-entry>行を削除</button></td>
            </tr>
          </tbody>
        </table>
      </div>
      <template data-overseas-entry-template>
        <tr data-overseas-entry-row>
          <td class="overseas-chobatsu-table__number"><input type="number" name="entries[new-__INDEX__][serial_number]" min="1" inputmode="numeric" pattern="[0-9]*" data-numeric-only="true" aria-label="番号"></td>
          <td><input type="text" name="entries[new-__INDEX__][assistant_name]" autocomplete="off" aria-label="引保師名"></td>
          <td><textarea name="entries[new-__INDEX__][notes]" rows="2" aria-label="備考"></textarea></td>
          <td class="overseas-chobatsu-table__action"><button type="button" class="button-danger" data-remove-overseas-entry>行を削除</button></td>
        </tr>
      </template>
      <div class="overseas-chobatsu-actions">
        <button type="button" class="button-secondary" data-add-overseas-entry>行を追加</button>
        <%= submit_tag "更新する", class: "button-primary overseas-chobatsu-save" %>
      </div>
    <% end %>
  </section>
</div>
