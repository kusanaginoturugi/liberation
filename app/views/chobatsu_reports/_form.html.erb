<% joint_rows = report.joint_contribution_form_values.presence || report.joint_report_contributions.map { |contribution| { fellowship_id: contribution.fellowship_id, participant_count: contribution.participant_count, serial_number_from: contribution.serial_number_from, serial_number_to: contribution.serial_number_to, additional_ranges: contribution.additional_serial_number_ranges.map { |range| { serial_number_from: range.serial_number_from, serial_number_to: range.serial_number_to } } } } %>
<% if joint_rows.empty? && report.joint_report? %>
  <% joint_rows = [
    { fellowship_id: report.joint_primary_fellowship_id.presence || report.fellowship_id, participant_count: report.joint_primary_participant_count, serial_number_from: report.joint_primary_serial_number_from.presence || report.serial_number_from, serial_number_to: report.joint_primary_serial_number_to.presence || report.serial_number_to, additional_ranges: [] },
    { fellowship_id: report.joint_secondary_fellowship_id, participant_count: report.joint_secondary_participant_count, serial_number_from: report.joint_secondary_serial_number_from, serial_number_to: report.joint_secondary_serial_number_to, additional_ranges: [] }
  ] %>
<% end %>
<% schedule_linked = report.ceremony_schedule_id.present? %>

<%= form_with(model: report, class: "report-form", data: { joint_report_form: true, joint_report: report.joint_report?, serial_number_conflicts_url: serial_number_conflicts_chobatsu_reports_path, event_id: report.event_id, report_id: report.id }) do |form| %>
  <%= form.hidden_field :ceremony_schedule_id %>
  <div class="field-grid">
    <div class="field <%= "field-with-error" if report.errors[:ceremony_date].any? %>">
      <%= form.label :ceremony_date, "挙行日" %>
      <%= form.date_field :ceremony_date %>
    </div>

    <% if schedule_linked %>
      <%= form.hidden_field :joint_report, value: report.joint_report? ? "1" : "0" %>
    <% else %>
      <div class="field joint-report-toggle">
        <%= form.label :joint_report do %>
          <%= form.check_box :joint_report, data: { joint_report_toggle: true } %>
          合同挙行として登録
        <% end %>
      </div>
    <% end %>

    <div data-regular-report-fields <%= "hidden" if report.joint_report? %>>
      <div class="field <%= "field-with-error" if report.errors[:fellowship].any? || report.errors[:fellowship_id].any? %>">
        <%= form.label :fellowship_id, "伝道会名" %>
        <%= form.collection_select :fellowship_id, fellowships, :id, :name, { prompt: "選択してください" }, { disabled: report.joint_report? } %>
      </div>

      <div class="field <%= "field-with-error" if report.errors[:participant_count].any? %>">
        <%= form.label :participant_count, "超抜引保師数" %>
        <div class="input-with-unit">
          <%= form.number_field :participant_count, min: 0, value: report.participant_count.presence, inputmode: "numeric", pattern: "[0-9]*", disabled: report.joint_report?, data: { numeric_only: true } %>
          <span class="input-unit">人</span>
        </div>
        <% report.errors.full_messages_for(:participant_count).each do |message| %><p class="field-error"><%= message %></p><% end %>
      </div>

      <%= render "number_ranges", form: form, report: report, total_serial_count: total_serial_count %>
    </div>

    <section class="joint-report-section" data-joint-report-fields <%= "hidden" unless report.joint_report? %>>
      <div data-joint-contributions>
        <% joint_rows.each_with_index do |row, index| %>
          <%= render "joint_contribution", report: report, fellowships: fellowships, row: row, index: index, total_serial_count: total_serial_count %>
        <% end %>
      </div>
      <button type="button" class="button-secondary compact-button" data-add-joint-contribution>伝道会を追加</button>
      <template data-joint-contribution-template><%= render "joint_contribution", report: report, fellowships: fellowships, row: {}, index: "NEW_RECORD", total_serial_count: total_serial_count %></template>
    </section>

    <div class="field <%= "field-with-error" if report.errors[:noah_card_count].any? %>">
      <%= form.label :noah_card_count, "ノアカード分" %>
      <%= form.number_field :noah_card_count, min: 0, value: report.noah_card_count.presence, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true } %>
      <% report.errors.full_messages_for(:noah_card_count).each do |message| %><p class="field-error"><%= message %></p><% end %>
    </div>

    <div class="field <%= "field-with-error" if report.errors[:notes].any? %>">
      <%= form.label :notes, "備考欄" %>
      <%= form.text_area :notes %>
    </div>

    <div class="field usage-field"><span class="field-label">使用数</span><div class="usage-count" data-calc-target="usageOutput"><%= report.usage_count %></div></div>
    <div class="field usage-field"><span class="field-label">功徳費合計</span><div class="usage-count" data-calc-target="meritOutput"><%= report.calculated_merit_fee_total %></div></div>
    <div class="field usage-field"><span class="field-label">みろく寺分</span><div class="usage-count" data-calc-target="mirokujiOutput"><%= report.mirokuji_share %></div></div>
    <div class="field usage-field"><span class="field-label">聖院還付金</span><div class="usage-count" data-calc-target="regionRefundOutput"><%= report.region_refund %></div></div>
  </div>

  <div class="actions"><%= form.submit submit_label, class: "button-primary" %></div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  (() => {
    const initializeReportForm = () => {
      document.querySelectorAll("[data-joint-report-form]").forEach((form) => {
        if (form.dataset.initialized === "true") return;
        form.dataset.initialized = "true";

        const toggle = form.querySelector("[data-joint-report-toggle]");
        const regularFields = form.querySelector("[data-regular-report-fields]");
        const jointFields = form.querySelector("[data-joint-report-fields]");
        const usageOutput = form.querySelector("[data-calc-target='usageOutput']");
        const meritOutput = form.querySelector("[data-calc-target='meritOutput']");
        const mirokujiOutput = form.querySelector("[data-calc-target='mirokujiOutput']");
        const regionRefundOutput = form.querySelector("[data-calc-target='regionRefundOutput']");
        const conflictUrl = form.dataset.serialNumberConflictsUrl;
        const conflictCache = new Map();
        let nextNumberRangeKey = Date.now();
        const newNumberRangeKey = () => String(++nextNumberRangeKey);

        const fellowshipIdFor = (list) => {
          const contribution = list.closest("[data-joint-contribution]");
          return contribution?.querySelector("[data-joint-fellowship]")?.value || form.querySelector("[name='chobatsu_report[fellowship_id]']")?.value;
        };

        const rangeValues = (range) => {
          const from = Number.parseInt(range.querySelector("[data-number-range-from]")?.value, 10);
          const to = Number.parseInt(range.querySelector("[data-number-range-to]")?.value || from, 10);
          return Number.isNaN(from) || Number.isNaN(to) || to < from ? null : { from, to };
        };

        const addRangeConflict = (range, message) => {
          if (range.querySelector("[data-number-range-conflict]")) return;
          const warning = document.createElement("p");
          warning.className = "field-error number-range-conflict";
          warning.dataset.numberRangeConflict = "true";
          warning.textContent = message;
          range.appendChild(warning);
        };

        const clearRangeConflicts = () => form.querySelectorAll("[data-number-range-conflict]").forEach((warning) => warning.remove());

        const checkRangeConflicts = async () => {
          clearRangeConflicts();
          const lists = Array.from(form.querySelectorAll("[data-number-range-list], [data-joint-number-range-list]"))
            .filter((list) => !list.querySelector("[data-number-range-from]")?.disabled);

          lists.forEach((list) => {
            const ranges = Array.from(list.querySelectorAll("[data-number-range]")).filter((range) => !range.hidden);
            ranges.forEach((range, index) => {
              const current = rangeValues(range);
              if (!current) return;
              ranges.slice(index + 1).forEach((otherRange) => {
                const other = rangeValues(otherRange);
                if (other && current.from <= other.to && current.to >= other.from) {
                  addRangeConflict(range, "同じ報告内で使用修霊番号が重複しています");
                  addRangeConflict(otherRange, "同じ報告内で使用修霊番号が重複しています");
                }
              });
            });
          });

          await Promise.all(lists.map(async (list) => {
            const fellowshipId = fellowshipIdFor(list);
            if (!conflictUrl || !fellowshipId) return;

            const cacheKey = String(fellowshipId);
            if (!conflictCache.has(cacheKey)) {
              const url = new URL(conflictUrl, window.location.origin);
              url.search = new URLSearchParams({ event_id: form.dataset.eventId, fellowship_id: fellowshipId, report_id: form.dataset.reportId || "" });
              const response = await fetch(url, { headers: { Accept: "application/json" } });
              if (!response.ok) return;
              conflictCache.set(cacheKey, (await response.json()).ranges);
            }

            if (fellowshipIdFor(list) !== fellowshipId) return;
            const registeredRanges = conflictCache.get(cacheKey) || [];
            Array.from(list.querySelectorAll("[data-number-range]")).filter((range) => !range.hidden).forEach((range) => {
              const current = rangeValues(range);
              const overlap = current && registeredRanges.find((registered) => current.from <= registered.to && current.to >= registered.from);
              if (overlap) addRangeConflict(range, `登録済みの番号 ${overlap.from}〜${overlap.to}（${overlap.ceremony_date}）と重複しています`);
            });
          }));
        };

        const updateJointLabels = () => {
          form.querySelectorAll("[data-joint-contribution]").forEach((contribution, index) => {
            const select = contribution.querySelector("[data-joint-fellowship]");
            const name = select?.value ? select.selectedOptions[0]?.textContent?.trim() : `伝道会${index + 1}`;
            contribution.querySelectorAll("[data-joint-contribution-label]").forEach((label) => {
              const type = label.dataset.jointContributionLabel;
              label.textContent = type === "participant" ? `${name}の超抜引保師数` : `${name}の使用修霊番号(${type})`;
            });
          });
        };

        const updateTotals = () => {
          const usageCount = Array.from(form.querySelectorAll("[data-number-range]"))
            .filter((range) => !range.querySelector("[data-number-range-from]").disabled)
            .reduce((total, range) => {
              const from = Number.parseInt(range.querySelector("[data-number-range-from]").value, 10);
              const to = Number.parseInt(range.querySelector("[data-number-range-to]").value || from, 10);
              return Number.isNaN(from) || Number.isNaN(to) || to < from ? total : total + to - from + 1;
            }, 0);
          const meritTotal = usageCount * 5000;
          usageOutput.textContent = String(usageCount);
          meritOutput.textContent = String(meritTotal);
          mirokujiOutput.textContent = String(Math.floor(meritTotal * 0.65));
          regionRefundOutput.textContent = String(Math.floor(meritTotal * 0.15));
        };

        const updateMode = () => {
          const joint = toggle ? toggle.checked : form.dataset.jointReport === "true";
          regularFields.hidden = joint;
          jointFields.hidden = !joint;
          regularFields.querySelectorAll("input, select, textarea, button").forEach((input) => { input.disabled = joint; });
          jointFields.querySelectorAll("input, select").forEach((input) => { input.disabled = !joint; });
          updateJointLabels();
          updateTotals();
        };

        toggle?.addEventListener("change", updateMode);
        form.addEventListener("change", (event) => {
          if (event.target.matches("[data-joint-fellowship]")) {
            updateJointLabels();
            checkRangeConflicts();
          }
        });
        form.addEventListener("input", (event) => {
          if (event.target.matches("[data-number-range-from], [data-number-range-to]")) {
            updateTotals();
            checkRangeConflicts();
          }
          if (event.target.matches("[name='chobatsu_report[fellowship_id]']")) checkRangeConflicts();
        });
        form.addEventListener("change", (event) => {
          if (event.target.matches("[name='chobatsu_report[fellowship_id]']")) checkRangeConflicts();
        });
        form.querySelectorAll("[data-number-range-list]").forEach((list) => {
          const additions = list.querySelector("[data-additional-number-ranges]");
          const template = list.querySelector("[data-number-range-template]");
          list.querySelector("[data-add-number-range]").addEventListener("click", () => {
            additions.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", newNumberRangeKey()));
            checkRangeConflicts();
          });
          list.addEventListener("click", (event) => {
            if (!event.target.matches("[data-remove-number-range]")) return;

            const range = event.target.closest("[data-number-range]");
            const destroyField = range.querySelector("[data-destroy-number-range]");
            if (range.dataset.persistedNumberRange === "true") {
              destroyField.value = "1";
              range.hidden = true;
            } else {
              range.remove();
            }
            updateTotals();
            checkRangeConflicts();
          });
        });
        const initializeJointNumberRangeList = (list) => {
          if (list.dataset.initialized === "true") return;
          list.dataset.initialized = "true";
          const additions = list.querySelector("[data-additional-number-ranges]");
          const template = list.querySelector("[data-joint-number-range-template]");
          list.querySelector("[data-add-joint-number-range]").addEventListener("click", () => {
            additions.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", newNumberRangeKey()));
            updateJointLabels();
            checkRangeConflicts();
          });
          list.addEventListener("click", (event) => {
            if (!event.target.matches("[data-remove-number-range]")) return;
            event.target.closest("[data-number-range]").remove();
            updateTotals();
            checkRangeConflicts();
          });
        };
        form.querySelectorAll("[data-joint-number-range-list]").forEach(initializeJointNumberRangeList);
        jointFields.querySelector("[data-add-joint-contribution]")?.addEventListener("click", () => {
          const template = jointFields.querySelector("[data-joint-contribution-template]");
          const additions = jointFields.querySelector("[data-joint-contributions]");
          additions.insertAdjacentHTML("beforeend", template.innerHTML.replaceAll("NEW_RECORD", newNumberRangeKey()));
          additions.lastElementChild.querySelectorAll("[data-joint-number-range-list]").forEach(initializeJointNumberRangeList);
          updateJointLabels();
        });
        jointFields.addEventListener("click", (event) => {
          if (!event.target.matches("[data-remove-joint-contribution]")) return;
          event.target.closest("[data-joint-contribution]").remove();
          updateTotals();
          checkRangeConflicts();
        });
        updateMode();
        checkRangeConflicts();
      });
    };

    document.addEventListener("turbo:load", initializeReportForm);
    document.addEventListener("DOMContentLoaded", initializeReportForm);
  })();
</script>
