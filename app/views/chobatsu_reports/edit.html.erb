<% content_for :title, "挙行報告 編集" %>

<div class="page-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Ceremony Report</p>
      <h1>挙行報告 編集</h1>
      <p class="page-context">対象超抜式: <strong><%= @chobatsu_report.event.name %></strong></p>
    </div>
    <div class="page-header-actions">
      <%= link_to "一覧に戻る", summary_chobatsu_reports_path(event_id: @chobatsu_report.event_id), class: "button-secondary compact-button" %>
      <div class="setting-card"><span>合格霊数</span><strong><%= @total_serial_count %></strong></div>
    </div>
  </header>

  <% if @chobatsu_report.errors.any? %>
    <div class="flash flash-alert"><strong>更新できませんでした</strong><ul><% @chobatsu_report.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>

  <div class="page-grid">
    <section class="panel form-panel">
      <h2>編集フォーム</h2>
      <%= render "form", report: @chobatsu_report, fellowships: @fellowships, total_serial_count: @total_serial_count, submit_label: "更新する" %>
    </section>
    <%= render "report_grid", chobatsu_reports: @chobatsu_reports, legend_fellowships: @legend_fellowships, total_serial_count: @total_serial_count %>
  </div>
</div>
