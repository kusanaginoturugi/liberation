<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>【<%= @selected_event.name %>】挙行一覧表@<%= @selected_region.name %></title>
    <style>
      body {
        margin: 24px;
        color: #2b231d;
        font-family: "Hiragino Sans", "Yu Gothic", sans-serif;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 28px;
      }

      p {
        margin: 0 0 16px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }

      th, td {
        border: 1px solid #6a5d52;
        padding: 8px 10px;
        text-align: left;
      }

      th {
        background: #f3eee8;
      }

      .print-note {
        margin-top: 16px;
        color: #6a5d52;
        font-size: 12px;
      }

      @media print {
        @page {
          size: A4 landscape;
          margin: 4mm;
        }

        body {
          margin: 0;
          font-size: 11px;
          font-weight: 600;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        h1 {
          margin: 0 0 3px;
          font-size: 17px;
          font-weight: 700;
          white-space: nowrap;
        }

        .report-export-table {
          height: 194mm;
          table-layout: fixed;
          font-size: 11px;
        }

        .report-export-table th,
        .report-export-table td {
          padding: 3px;
          line-height: 1.15;
          text-align: center;
          vertical-align: middle;
        }

        .report-export-table tr {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        .report-export-table th:nth-child(1) { width: 3%; }
        .report-export-table th:nth-child(2) { width: 6%; }
        .report-export-table th:nth-child(3) { width: 9%; }
        .report-export-table th:nth-child(4) { width: 8%; }
        .report-export-table th:nth-child(5) { width: 7%; }
        .report-export-table th:nth-child(6) { width: 20%; }
        .report-export-table th:nth-child(7) { width: 12%; }
        .report-export-table th:nth-child(8) { width: 13%; }
        .report-export-table th:nth-child(9) { width: 11%; }
        .report-export-table th:nth-child(10) { width: 4%; }
        .report-export-table th:nth-child(11) { width: 7%; }

        .report-export-table th:nth-child(-n+9),
        .report-export-table td:nth-child(-n+9),
        .report-export-table th:nth-child(11),
        .report-export-table td:nth-child(11) {
          white-space: nowrap;
        }

        .report-export-table th:nth-child(4),
        .report-export-table td:nth-child(4),
        .report-export-table th:nth-child(5),
        .report-export-table td:nth-child(5),
        .report-export-table th:nth-child(7),
        .report-export-table td:nth-child(7),
        .report-export-table th:nth-child(8),
        .report-export-table td:nth-child(8),
        .report-export-table th:nth-child(9),
        .report-export-table td:nth-child(9) {
          text-align: right;
        }

        .report-export-table th:nth-child(6),
        .report-export-table td:nth-child(6) {
          text-align: left;
        }

        .joint-report-spacer {
          height: 1.15em;
        }

        .print-note {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <h1><%= @selected_event.name %>挙行一覧　<%= @selected_region.name %></h1>

    <table class="report-export-table">
      <thead>
        <tr>
          <th>No.</th>
          <th>挙行日</th>
          <th>伝道会名</th>
          <th>超抜引保師数</th>
          <th>超抜霊数</th>
          <th>使用番号</th>
          <th>功徳費合計</th>
          <th>みろく寺分<br><small style="font-size: 0.75em; font-weight: normal">(ノア分勘案せず)</small></th>
          <th>聖院還付金</th>
          <th>備考欄</th>
          <th>入力者名</th>
        </tr>
      </thead>
      <tbody>
        <% @export_reports.each_with_index do |report, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= report.ceremony_date.strftime("%m/%d") %></td>
            <td><% report.report_display_name_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><div class="joint-report-spacer" aria-hidden="true"<%= " hidden" unless report.joint_report? %>></div><% report.participant_count_value_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><div class="joint-report-spacer" aria-hidden="true"<%= " hidden" unless report.joint_report? %>></div><% report.usage_count_value_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><div class="joint-report-spacer" aria-hidden="true"<%= " hidden" unless report.joint_report? %>></div><% report.serial_number_range_value_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><%= yen_amount(report.calculated_merit_fee_total) %></td>
            <td><%= yen_amount(report.mirokuji_share) %></td>
            <td><%= yen_amount(report.region_refund) %></td>
            <td><%= report.notes %></td>
            <td><%= report.user&.name || "未設定" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="print-note">この画面は印刷用です。ブラウザの印刷機能から PDF 保存してください。</p>

    <script nonce="<%= content_security_policy_nonce %>">
      window.addEventListener("load", () => window.print());
    </script>
  </body>
</html>
