<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>挙行報告 PDF出力</title>
    <style>
      body {
        margin: 24px;
        color: #2b231d;
        font-family: "Hiragino Sans", "Yu Gothic", sans-serif;
      }

      h1 {
        margin: 0 0 8px;
        font-size: 28px;
      }

      p {
        margin: 0 0 16px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }

      th, td {
        border: 1px solid #6a5d52;
        padding: 8px 10px;
        text-align: left;
      }

      th {
        background: #f3eee8;
      }

      .print-note {
        margin-top: 16px;
        color: #6a5d52;
        font-size: 12px;
      }

      @media print {
        @page {
          size: A4 portrait;
          margin: 7mm;
        }

        body {
          margin: 0;
          font-size: 8px;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        h1 {
          margin-bottom: 2px;
          font-size: 15px;
        }

        p {
          margin-bottom: 5px;
          font-size: 9px;
        }

        .report-export-table {
          table-layout: fixed;
          font-size: 7.5px;
        }

        .report-export-table th,
        .report-export-table td {
          padding: 3px 4px;
          line-height: 1.2;
          overflow-wrap: anywhere;
          vertical-align: top;
        }

        .report-export-table tr {
          break-inside: avoid;
          page-break-inside: avoid;
        }

        .report-export-table th:nth-child(1) { width: 3%; }
        .report-export-table th:nth-child(2) { width: 7%; }
        .report-export-table th:nth-child(3) { width: 12%; }
        .report-export-table th:nth-child(4) { width: 9%; }
        .report-export-table th:nth-child(5) { width: 8%; }
        .report-export-table th:nth-child(6) { width: 7%; }
        .report-export-table th:nth-child(7) { width: 12%; }
        .report-export-table th:nth-child(8) { width: 13%; }
        .report-export-table th:nth-child(9) { width: 11%; }
        .report-export-table th:nth-child(10) { width: 8%; }
        .report-export-table th:nth-child(11) { width: 10%; }

        .print-note {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <h1>挙行報告</h1>
    <p><%= @selected_event.name %></p>

    <table class="report-export-table">
      <thead>
        <tr>
          <th>No.</th>
          <th>挙行日</th>
          <th>伝道会名</th>
          <th>超抜引保師数</th>
          <th>超抜霊数</th>
          <th>(内)ノアカード分</th>
          <th>功徳費合計</th>
          <th>みろく寺分<br><small style="font-size: 0.75em; font-weight: normal">(ノア分勘案せず)</small></th>
          <th>聖院還付金</th>
          <th>備考欄</th>
          <th>入力者名</th>
        </tr>
      </thead>
      <tbody>
        <% @export_reports.each_with_index do |report, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= report.ceremony_date.strftime("%Y/%m/%d") %></td>
            <td><% report.report_display_name_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><% report.participant_count_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><% report.usage_count_lines.each do |line| %><div><%= line %></div><% end %></td>
            <td><%= report.noah_card_count.present? ? report.noah_card_count : "-" %></td>
            <td><%= report.calculated_merit_fee_total %></td>
            <td><%= report.mirokuji_share %></td>
            <td><%= report.region_refund %></td>
            <td><%= report.notes %></td>
            <td><%= report.user&.name || "未設定" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="print-note">この画面は印刷用です。ブラウザの印刷機能から PDF 保存してください。</p>

    <script nonce="<%= content_security_policy_nonce %>">
      window.addEventListener("load", () => window.print());
    </script>
  </body>
</html>
