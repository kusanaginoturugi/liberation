<% content_for :title, "挙行報告" %>

<div class="page-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Ceremony Report</p>
      <h1>挙行報告</h1>
      <p class="page-context">対象超抜式: <strong><%= @selected_event.name %></strong></p>
    </div>
    <div class="page-header-actions">
      <details class="nav-dropdown">
        <summary class="button-secondary nav-dropdown__summary">CSV出力</summary>
        <div class="nav-dropdown__menu">
          <%= link_to "UTF-8", export_chobatsu_reports_path(format: :csv, event_id: @selected_event&.id, region_id: current_user.region_id, encoding: :utf8), class: "nav-dropdown__item" %>
          <%= link_to "UTF-8(BOM)", export_chobatsu_reports_path(format: :csv, event_id: @selected_event&.id, region_id: current_user.region_id, encoding: :utf8_bom), class: "nav-dropdown__item" %>
          <%= link_to "SJIS", export_chobatsu_reports_path(format: :csv, event_id: @selected_event&.id, region_id: current_user.region_id, encoding: :sjis), class: "nav-dropdown__item" %>
        </div>
      </details>
      <%= link_to "PDF出力", export_chobatsu_reports_path(event_id: @selected_event&.id, region_id: current_user.region_id), class: "button-secondary compact-button", target: "_blank", rel: "noopener" %>
      <div class="setting-card"><span>合格霊数</span><strong><%= @total_serial_count %></strong></div>
      <div class="setting-card"><span>超抜済</span><strong><%= used_serial_count(@chobatsu_reports) %></strong></div>
      <div class="setting-card"><span>残霊数</span><strong><%= remaining_serial_count(@total_serial_count, @chobatsu_reports) %></strong></div>
    </div>
  </header>

  <% if flash[:notice].present? %><div class="flash flash-notice"><%= flash[:notice] %></div><% end %>
  <% if @chobatsu_report.errors.any? %>
    <div class="flash flash-alert"><strong>登録できませんでした</strong><ul><% @chobatsu_report.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>

  <div class="page-grid">
    <section class="panel form-panel">
      <h2>登録フォーム</h2>
      <%= render "form", report: @chobatsu_report, fellowships: @fellowships, total_serial_count: @total_serial_count, submit_label: "登録する" %>
    </section>
    <%= render "report_grid", chobatsu_reports: @chobatsu_reports, legend_fellowships: @legend_fellowships, total_serial_count: @total_serial_count %>
  </div>
</div>
