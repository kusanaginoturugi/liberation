<% display_event_name = @event.name %>
<% content_for :title, "#{display_event_name}の合格霊数設定" %>

<div class="page-shell">
  <div class="panel">
    <div class="panel-header">
      <h1><%= display_event_name %>の合格霊数設定</h1>
      <%= link_to "戻る", root_path, class: "button-secondary compact-button" %>
    </div>

    <% if flash[:notice].present? %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <table class="admin-table">
      <thead>
        <tr>
          <th>超抜式</th>
          <th>合格霊数</th>
          <% unless @event.closed? %>
            <th style="width: 9em">操作</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @event_details.each do |event_detail| %>
          <% form_id = dom_id(event_detail, :update) %>
          <tr>
            <td><%= display_event_name %></td>
            <td>
              <% if @event.closed? %>
                <%= number_with_delimiter(event_detail.total_serial_count) %>
              <% else %>
                <%= form_with model: [@event, event_detail], id: form_id do |form| %>
                  <%= form.number_field :total_serial_count, min: 1, required: true, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true } %>
                <% end %>
              <% end %>
            </td>
            <% unless @event.closed? %>
              <td><%= submit_tag "更新する", form: form_id, class: "button-primary compact-button" %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
