<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= @selected_event.name %> 挙行予定表</title>
    <style>
      @page { size: A4 portrait; margin: 10mm; }
      * { box-sizing: border-box; }
      body { margin: 0; color: #000; font-family: "Noto Sans CJK JP", "Noto Sans JP", sans-serif; font-size: 8.5pt; }
      h1, h2, p { margin: 0; }
      h1 { font-size: 15pt; }
      h2 { font-size: 10pt; }
      .document-header, .section-heading { display: flex; align-items: baseline; justify-content: space-between; }
      .document-header { border-bottom: 1px solid #000; margin-bottom: 4mm; padding-bottom: 2mm; }
      .section-heading { margin: 3mm 0 1.5mm; }
      .total { font-weight: 700; }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      th, td { border: 0.5px solid #000; overflow-wrap: anywhere; padding: 1.4mm 1.6mm; text-align: left; vertical-align: middle; }
      th { font-weight: 700; text-align: center; }
      .number { text-align: right; white-space: nowrap; }
      .center { text-align: center; }
      .schedule-fellowship { width: 15%; }
      .schedule-date { width: 20%; }
      .schedule-place { width: 25%; }
      .schedule-assistants { width: 12%; }
      .schedule-spirits { width: 11%; }
      .schedule-minister { width: 17%; }
      .allocation-fellowship { width: 42%; }
      .allocation-spirits { width: 20%; }
      .allocation-numbers { width: 38%; }
      .empty { text-align: center; }
    </style>
  </head>
  <body>
    <header class="document-header">
      <h1>挙行予定表・番号割り振り</h1>
      <p><%= @selected_event.name %></p>
    </header>

    <section>
      <div class="section-heading"><h2>予定表</h2><p class="total">霊数合計 <%= number_with_delimiter(@ceremony_schedules.sum(&:spirit_count)) %></p></div>
      <table>
        <thead><tr><th class="schedule-fellowship">伝道会名</th><th class="schedule-date">挙行日時</th><th class="schedule-place">場所</th><th class="schedule-assistants">引保師数</th><th class="schedule-spirits">霊数</th><th class="schedule-minister">超抜点伝師</th></tr></thead>
        <tbody>
          <% if @ceremony_schedules.empty? %>
            <tr><td colspan="6" class="empty">挙行予定はまだありません</td></tr>
          <% else %>
            <% @ceremony_schedules.each do |schedule| %>
              <tr><td><%= schedule.fellowship.name %></td><td><%= l(schedule.ceremony_at, format: :schedule) %></td><td><%= schedule.place %></td><td class="number"><%= number_with_delimiter(schedule.assistant_count) %></td><td class="number"><%= number_with_delimiter(schedule.spirit_count) %></td><td><%= schedule.minister_name.presence || "-" %></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </section>

    <section>
      <div class="section-heading"><h2>番号割り振り</h2><p>伝道会ごとの霊数合計</p></div>
      <table>
        <thead><tr><th class="allocation-fellowship">伝道会名</th><th class="allocation-spirits">霊数</th><th class="allocation-numbers">番号</th></tr></thead>
        <tbody>
          <% if @allocation_rows.empty? %>
            <tr><td colspan="3" class="empty">番号を割り振る予定はまだありません</td></tr>
          <% else %>
            <% @allocation_rows.each do |row| %>
              <tr><td><%= row[:fellowship].name %></td><td class="number"><%= number_with_delimiter(row[:spirit_count]) %></td><td class="center"><%= number_with_delimiter(row[:serial_number_from]) %> 〜 <%= number_with_delimiter(row[:serial_number_to]) %></td></tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </section>
  </body>
</html>
