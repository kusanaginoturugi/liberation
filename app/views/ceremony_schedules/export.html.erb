<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title><%= @selected_event.name %> 挙行予定表</title>
    <style>
      @page { size: A4 portrait; margin: 7mm; }
      * { box-sizing: border-box; }
      body { margin: 0; color: #000; font-family: "Noto Sans CJK JP", "Noto Sans JP", sans-serif; font-size: 7.4pt; line-height: 1.1; }
      h1, h2, p { margin: 0; }
      h1 { font-size: 13pt; }
      h2 { font-size: 8.8pt; }
      .document-header, .section-heading { display: flex; align-items: baseline; justify-content: space-between; }
      .document-header { border-bottom: 1px solid #000; margin-bottom: 2.5mm; padding-bottom: 1.2mm; }
      .section-heading { margin: 2mm 0 1mm; }
      .totals { display: flex; gap: 4mm; font-weight: 700; }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      tr { height: 7.2mm; }
      th, td { border: 0.5px solid #000; overflow-wrap: anywhere; padding: 0.65mm 1mm; text-align: left; vertical-align: middle; }
      th { font-weight: 700; text-align: center; }
      .number { text-align: right; white-space: nowrap; }
      .joint-schedule-name { line-height: 1.2; }
      .joint-count { padding-top: 0.4mm; padding-bottom: 0.4mm; text-align: left; white-space: normal; }
      .joint-count-line { display: flex; justify-content: space-between; gap: 1mm; line-height: 1.2; white-space: nowrap; }
      .joint-count-value { margin-left: auto; text-align: right; }
      .special-count .joint-count-line { justify-content: flex-start; gap: 0.2em; }
      .special-count .joint-count-value { margin-left: 0; }
      .center { text-align: center; }
      .schedule-fellowship { width: 15%; }
      .schedule-date { width: 20%; }
      .schedule-place { width: 25%; }
      .schedule-assistants { width: 12%; }
      .schedule-spirits { width: 11%; }
      .schedule-minister { width: 17%; }
      .allocation-fellowship { width: 30%; }
      .allocation-altars { width: 10%; }
      .allocation-spirits { width: 12%; }
      .allocation-requested { width: 16%; }
      .allocation-numbers { width: 32%; }
      .allocation-table td { vertical-align: middle; }
      .allocation-table td.allocation-fellowship { text-align: left; }
      .allocation-table td.allocation-altars,
      .allocation-table td.allocation-numbers { text-align: right; }
      .allocation-counts { display: flex; align-items: center; justify-content: flex-end; gap: 2mm; font-variant-numeric: tabular-nums; }
      .allocation-final-count { min-width: 9mm; text-align: right; }
      .allocation-breakdown { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3mm; text-align: right; }
      .allocation-addition { color: #6c58ab; font-size: 6.4pt; font-weight: 700; white-space: nowrap; }
      .empty { text-align: center; }
    </style>
  </head>
  <body>
    <header class="document-header">
      <h1>挙行予定表・番号割り振り</h1>
      <p><%= @selected_event.name %></p>
    </header>

    <section>
      <div class="section-heading"><h2>予定表</h2><div class="totals"><p>予定霊数合計 <%= number_with_delimiter(@scheduled_spirit_total) %></p><p>合格霊数 <%= @qualified_spirit_count ? number_with_delimiter(@qualified_spirit_count) : "未設定" %></p></div></div>
      <table>
        <thead><tr><th class="schedule-fellowship">伝道会名</th><th class="schedule-date">挙行日時</th><th class="schedule-place">場所</th><th class="schedule-assistants">引保師数</th><th class="schedule-spirits">霊数</th><th class="schedule-minister">超抜点伝師</th></tr></thead>
        <tbody>
          <% if @ceremony_schedules.empty? %>
            <tr><td colspan="6" class="empty">挙行予定はまだありません</td></tr>
          <% else %>
            <% @ceremony_schedules.each do |schedule| %>
              <tr>
                <td class="<%= "joint-schedule-name" if schedule.joint_schedule? %>">
                  <% if schedule.special_schedule? %>
                    【特別】<br>海外・聖泉珠院
                  <% elsif schedule.joint_schedule? %>
                    【合同】<br><%= schedule.joint_fellowship_counts.pluck(:name).join("・") %>
                  <% else %>
                    <%= schedule.display_name %>
                  <% end %>
                </td>
                <td><%= schedule.ceremony_at.strftime("%Y/%m/%d　　%H:%M") %></td>
                <td><%= schedule.place %></td>
                <% if schedule.joint_schedule? %>
                  <td class="joint-count">
                    <% schedule.joint_fellowship_counts.each do |count| %>
                      <span class="joint-count-line"><span><%= count[:name] %></span><span class="joint-count-value"><%= count[:assistant_count] ? number_with_delimiter(count[:assistant_count]) : "-" %></span></span>
                    <% end %>
                  </td>
                  <td class="joint-count">
                    <% schedule.joint_fellowship_counts.each do |count| %>
                      <span class="joint-count-line"><span><%= count[:name] %></span><span class="joint-count-value"><%= number_with_delimiter(count[:spirit_count]) %></span></span>
                    <% end %>
                  </td>
                <% elsif schedule.special_schedule? %>
                  <td class="number"><%= schedule.assistant_count ? number_with_delimiter(schedule.assistant_count) : "-" %></td>
                  <td class="joint-count special-count">
                    <% schedule.special_spirit_breakdown.each do |name, count| %>
                      <span class="joint-count-line"><span><%= name %></span><span class="joint-count-value"><%= number_with_delimiter(count) %></span></span>
                    <% end %>
                  </td>
                <% else %>
                  <td class="number"><%= schedule.assistant_count ? number_with_delimiter(schedule.assistant_count) : "-" %></td>
                  <td class="number"><%= schedule.spirit_count ? number_with_delimiter(schedule.spirit_count) : "-" %></td>
                <% end %>
                <td><%= schedule.minister_name.presence || "-" %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </section>

    <section>
      <div class="section-heading"><h2>番号割り振り</h2><p>伝道会ごとの霊数合計</p></div>
      <table class="allocation-table">
        <thead><tr><th class="allocation-fellowship">伝道会名</th><th class="allocation-altars">壇数</th><th class="allocation-spirits">霊数</th><th class="allocation-requested">希望数<br>（追加数）</th><th class="allocation-numbers">番号</th></tr></thead>
        <tbody>
          <% if @allocation_rows.empty? %>
            <tr><td colspan="5" class="empty">番号を割り振る予定はまだありません</td></tr>
          <% else %>
            <% @allocation_rows.each do |row| %>
              <tr>
                <td class="allocation-fellowship"><%= row[:fellowship].name %></td>
                <td class="allocation-altars"><%= "#{row[:altar_count]}壇" if row[:altar_count].positive? %></td>
                <td class="allocation-spirits">
                  <span class="allocation-final-count"><%= number_with_delimiter(row[:spirit_count]) %></span>
                </td>
                <td class="allocation-requested">
                  <span class="allocation-breakdown">
                    <span><%= number_with_delimiter(row[:scheduled_spirit_count]) %></span>
                    <% if row[:distribution_addition].nonzero? %>
                      <span class="allocation-addition">（<%= row[:distribution_addition].positive? ? "＋" : "−" %><%= number_with_delimiter(row[:distribution_addition].abs) %>）</span>
                    <% end %>
                  </span>
                </td>
                <td class="allocation-numbers"><%= row[:serial_number_from] ? "#{number_with_delimiter(row[:serial_number_from])} 〜 #{number_with_delimiter(row[:serial_number_to])}" : "-" %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </section>
  </body>
</html>
