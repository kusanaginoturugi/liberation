<% content_for :title, "挙行予定表" %>

<div class="page-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Ceremony Schedule</p>
      <h1>挙行予定表</h1>
      <p class="page-context">対象超抜式: <strong><%= @selected_event.name %></strong></p>
    </div>
    <% if user_signed_in? && (current_user.admin? || current_user.fellowship.present?) %>
      <%= link_to "予定追加", new_ceremony_schedule_path(event_id: @selected_event.id), class: "button-secondary" %>
    <% end %>
  </header>

  <% if flash[:notice].present? %>
    <div class="flash flash-notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="flash flash-alert"><%= flash[:alert] %></div>
  <% end %>

  <section class="panel region-filter-panel">
    <%= form_with url: ceremony_schedules_path, method: :get, class: "region-filter-form" do |form| %>
      <div class="field">
        <%= form.label :event_id, "超抜式" %>
        <%= form.collection_select :event_id, @events, :id, :name, { selected: @selected_event.id }, { onchange: "this.form.requestSubmit()" } %>
      </div>
    <% end %>
  </section>

  <div class="schedule-workspace">
  <section class="panel schedule-workspace__schedule">
    <div class="panel-header">
      <h2>予定一覧</h2>
      <p class="schedule-spirit-total">霊数合計 <strong><%= number_with_delimiter(@ceremony_schedules.sum(&:spirit_count)) %></strong></p>
    </div>

    <div class="summary-table-wrapper">
      <table class="admin-table ceremony-schedule-table <%= "ceremony-schedule-table--with-actions" if user_signed_in? %>">
        <thead>
          <tr>
            <th>伝道会名</th>
            <th>挙行日時</th>
            <th>場所</th>
            <th class="summary-number">引保師数</th>
            <th class="summary-number">霊数</th>
            <th>超抜点伝師</th>
            <% if user_signed_in? %>
              <th style="width: 10em">操作</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @ceremony_schedules.each_with_index do |schedule, index| %>
            <tr class="<%= index.even? ? "schedule-row-even" : "schedule-row-odd" %>">
              <td data-label="伝道会名"><%= schedule.fellowship.name %></td>
              <td data-label="挙行日時"><%= l(schedule.ceremony_at, format: :schedule) %></td>
              <td data-label="場所"><%= schedule.place %></td>
              <td class="summary-number" data-label="引保師数"><%= number_with_delimiter(schedule.assistant_count) %></td>
              <td class="summary-number" data-label="霊数"><%= number_with_delimiter(schedule.spirit_count) %></td>
              <td data-label="超抜点伝師"><%= schedule.minister_name.presence || "-" %></td>
              <% if user_signed_in? %>
                <td class="summary-actions" data-label="操作">
                  <% if current_user.admin? || schedule.fellowship_id == current_user.fellowship_id %>
                    <%= link_to "編集", edit_ceremony_schedule_path(schedule), class: "text-link" %>
                    <%= button_to "削除", ceremony_schedule_path(schedule), method: :delete,
                        class: "button-danger",
                        form: { data: { turbo_confirm: "この挙行予定を削除しますか？" } } %>
                  <% else %>
                    -
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
          <% if @ceremony_schedules.empty? %>
            <tr>
              <td colspan="<%= user_signed_in? ? 7 : 6 %>" class="summary-empty">挙行予定はまだありません</td>
            </tr>
          <% end %>
        </tbody>
        <% unless @ceremony_schedules.empty? %>
          <tfoot>
            <tr class="summary-total-row">
              <td colspan="4" class="summary-total-label">合計</td>
              <td class="summary-number"><%= number_with_delimiter(@ceremony_schedules.sum(&:spirit_count)) %></td>
              <td></td>
              <% if user_signed_in? %><td></td><% end %>
            </tr>
          </tfoot>
        <% end %>
      </table>
    </div>
    <% unless @ceremony_schedules.empty? %>
      <p class="mobile-summary-total">霊数合計 <strong><%= number_with_delimiter(@ceremony_schedules.sum(&:spirit_count)) %></strong></p>
    <% end %>
  </section>
  <section class="panel schedule-workspace__allocations">
    <div class="panel-header">
      <h2>番号割り振り</h2>
      <p>伝道会ごとの霊数合計</p>
    </div>

    <% if @allocation_rows.empty? %>
      <p class="summary-empty">挙行予定を入力すると、ここに伝道会ごとの合計が表示されます</p>
    <% else %>
      <div class="allocation-list">
        <div class="allocation-list__header">
          <%= link_to ceremony_schedules_path(
                event_id: @selected_event.id,
                allocation_sort: :fellowship,
                allocation_direction: @allocation_sort_direction == :asc ? :desc : :asc
              ),
              class: "allocation-sort-link" do %>
            伝道会名
            <span><%= @allocation_sort_direction == :asc ? "▲" : "▼" %></span>
          <% end %>
          <span>霊数</span>
          <span>番号</span>
        </div>
        <% @allocation_rows.each do |row| %>
          <% fellowship = row[:fellowship] %>
          <article class="allocation-row">
            <strong><%= fellowship.name %></strong>
            <% if current_user&.admin? %>
              <%= form_with model: row[:allocation], class: "allocation-count-form" do |form| %>
                <%= form.hidden_field :event_id %>
                <%= form.hidden_field :fellowship_id %>
                <%= form.number_field :spirit_count, min: 0, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true }, onfocus: "this.select()", onchange: "this.form.requestSubmit()" %>
              <% end %>
            <% else %>
              <span><%= number_with_delimiter(row[:spirit_count]) %></span>
            <% end %>
            <span><%= number_with_delimiter(row[:serial_number_from]) %> 〜 <%= number_with_delimiter(row[:serial_number_to]) %></span>
          </article>
        <% end %>
      </div>
    <% end %>
  </section>
  </div>
</div>
