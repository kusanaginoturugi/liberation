<% if ceremony_schedule.errors.any? %>
  <div class="flash flash-alert">
    <strong>保存できませんでした</strong>
    <ul>
      <% ceremony_schedule.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: ceremony_schedule, class: "report-form" do |form| %>
  <%= hidden_field_tag :event_id, @selected_event.id %>
  <div class="field-grid"
       data-special-schedule-form
       data-joint-schedule-form
       data-special-schedule-fellowship-id="<%= @special_fellowship&.id %>"
       data-special-schedule-fellowship-name="聖明王院">
    <% if current_user.admin? %>
      <div class="field special-schedule-toggle-field">
        <label>
          <%= form.check_box :special_schedule, data: { special_schedule_toggle: true } %>
          聖泉珠院・海外として登録
        </label>
      </div>
      <div class="field special-schedule-toggle-field">
        <label>
          <%= form.check_box :joint_schedule, data: { joint_schedule_toggle: true } %>
          合同挙行
        </label>
      </div>
    <% end %>

    <div class="field" data-special-schedule-fellowship>
      <%= form.label :fellowship_id, "伝道会名" %>
      <% if current_user.admin? %>
        <%= form.collection_select :fellowship_id, @fellowships, :id, :name,
                                   { prompt: "選択してください" },
                                   { required: true, disabled: ceremony_schedule.joint_schedule?, data: { regular_fellowship: true } } %>
      <% elsif current_user.fellowship.present? %>
        <p class="readonly-field"><%= current_user.fellowship.name %></p>
      <% else %>
        <p class="readonly-field">未設定</p>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <div class="field joint-schedule-section" data-joint-schedule-fields hidden>
        <span class="field-label">伝道会名</span>
        <div class="joint-schedule-section__inputs">
          <div class="field">
            <%= label_tag :joint_primary_fellowship_id, "伝道会①" %>
            <%= select_tag "ceremony_schedule[fellowship_id]",
                           options_from_collection_for_select(@fellowships, :id, :name, ceremony_schedule.fellowship_id),
                           include_blank: "選択してください",
                           id: :joint_primary_fellowship_id,
                           disabled: !ceremony_schedule.joint_schedule?,
                           data: { joint_primary_fellowship: true } %>
          </div>
          <div class="field">
            <%= label_tag :joint_fellowship_id, "伝道会②" %>
            <%= select_tag "ceremony_schedule[joint_fellowship_id]",
                           options_from_collection_for_select(@fellowships, :id, :name, ceremony_schedule.joint_secondary_fellowship&.id),
                           include_blank: "選択してください",
                           id: :joint_fellowship_id,
                           disabled: !ceremony_schedule.joint_schedule?,
                           data: { joint_secondary_fellowship: true } %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="field special-schedule-name" data-special-schedule-name hidden>
      <span class="field-label">予定区分</span>
      <p class="readonly-field">聖泉珠院・海外（特別）</p>
    </div>

    <div class="field special-schedule-name" data-special-schedule-fellowship-name hidden>
      <span class="field-label">伝道会名</span>
      <p class="readonly-field">聖明王院</p>
    </div>

    <div class="field">
      <%= form.label :ceremony_at, "挙行日時" %>
      <div class="schedule-datetime-picker" data-schedule-datetime-picker>
        <%= form.hidden_field :ceremony_at,
                              value: ceremony_schedule.ceremony_at&.strftime("%Y-%m-%dT%H:%M"),
                              data: { schedule_datetime_value: true } %>
        <button type="button" class="schedule-date-button" data-schedule-date-button aria-expanded="false">
          日付を選択
        </button>
        <%= time_field_tag "ceremony_schedule_time", ceremony_schedule.ceremony_at&.strftime("%H:%M"), class: "schedule-time-input", data: { schedule_time_input: true }, aria: { label: "挙行時刻" } %>
        <div class="schedule-calendar" data-schedule-calendar hidden>
          <div class="schedule-calendar__header">
            <button type="button" class="calendar-nav-button" data-schedule-calendar-previous aria-label="前の月">‹</button>
            <strong data-schedule-calendar-title></strong>
            <button type="button" class="calendar-nav-button" data-schedule-calendar-next aria-label="次の月">›</button>
          </div>
          <div class="schedule-calendar__weekdays" aria-hidden="true">
            <span>月</span><span>火</span><span>水</span><span>木</span><span>金</span><span class="is-saturday">土</span><span class="is-sunday">日</span>
          </div>
          <div class="schedule-calendar__days" data-schedule-calendar-days></div>
        </div>
      </div>
    </div>

    <div class="field">
      <%= form.label :place, "場所" %>
      <%= form.text_field :place, required: true, data: { special_schedule_place: true } %>
    </div>

    <div class="field" data-regular-assistant-count>
      <%= form.label :assistant_count, "引保師数" %>
      <%= form.number_field :assistant_count, min: 0, inputmode: "numeric", pattern: "[0-9]*", disabled: ceremony_schedule.joint_schedule?, data: { numeric_only: true, regular_assistant_count: true } %>
    </div>

    <% if current_user.admin? %>
      <div class="field joint-schedule-section" data-joint-schedule-fields hidden>
        <span class="field-label">引保師数</span>
        <div class="joint-schedule-section__inputs">
          <div class="field">
            <label for="joint_primary_assistant_count" data-joint-primary-fellowship-name>伝道会①</label>
            <%= number_field_tag "ceremony_schedule[primary_assistant_count]",
                                 ceremony_schedule.joint_primary_assistant_count,
                                 min: 0,
                                 inputmode: "numeric",
                                 pattern: "[0-9]*",
                                 id: :joint_primary_assistant_count,
                                 disabled: !ceremony_schedule.joint_schedule?,
                                 data: { numeric_only: true, joint_primary_assistant_count: true } %>
          </div>
          <div class="field">
            <label for="joint_secondary_assistant_count" data-joint-secondary-fellowship-name>伝道会②</label>
            <%= number_field_tag "ceremony_schedule[secondary_assistant_count]",
                                 ceremony_schedule.joint_secondary_assistant_count,
                                 min: 0,
                                 inputmode: "numeric",
                                 pattern: "[0-9]*",
                                 id: :joint_secondary_assistant_count,
                                 disabled: !ceremony_schedule.joint_schedule?,
                                 data: { numeric_only: true, joint_secondary_assistant_count: true } %>
          </div>
        </div>
      </div>
    <% end %>

    <div class="field" data-regular-spirit-count>
      <%= form.label :spirit_count, "霊数" %>
      <%= form.number_field :spirit_count, min: 0, inputmode: "numeric", pattern: "[0-9]*", disabled: ceremony_schedule.joint_schedule?, data: { numeric_only: true, special_spirit_count: true, regular_spirit_count: true } %>
    </div>

    <% if current_user.admin? %>
      <div class="field joint-schedule-section" data-joint-schedule-fields hidden>
        <span class="field-label">霊数</span>
        <div class="joint-schedule-section__inputs">
          <div class="field">
            <label for="joint_primary_spirit_count" data-joint-primary-fellowship-name>伝道会①</label>
          <%= number_field_tag "ceremony_schedule[primary_spirit_count]",
                               ceremony_schedule.joint_primary_spirit_count,
                               min: 0,
                               inputmode: "numeric",
                               pattern: "[0-9]*",
                               id: :joint_primary_spirit_count,
                               disabled: !ceremony_schedule.joint_schedule?,
                               data: { numeric_only: true, joint_primary_spirit_count: true } %>
          </div>
          <div class="field">
            <label for="joint_secondary_spirit_count" data-joint-secondary-fellowship-name>伝道会②</label>
          <%= number_field_tag "ceremony_schedule[secondary_spirit_count]",
                               ceremony_schedule.joint_secondary_spirit_count,
                               min: 0,
                               inputmode: "numeric",
                               pattern: "[0-9]*",
                               id: :joint_secondary_spirit_count,
                               disabled: !ceremony_schedule.joint_schedule?,
                               data: { numeric_only: true, joint_secondary_spirit_count: true } %>
          </div>
        </div>
        <p class="joint-schedule-section__total" data-joint-spirit-count-total>合計 - 霊</p>
      </div>
    <% end %>

    <div class="field special-schedule-number-range" data-special-schedule-number-range hidden>
      <span class="field-label">番号</span>
      <div class="special-schedule-number-range__inputs">
        <label>始<%= form.number_field :serial_number_from, min: 1, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true, special_serial_from: true } %></label>
        <label>終<%= form.number_field :serial_number_to, min: 1, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true, special_serial_to: true } %></label>
      </div>
      <p class="special-schedule-number-range__total" data-special-serial-total>合計 - 霊</p>
    </div>

    <div class="field">
      <%= form.label :minister_name, "超抜点伝師" %>
      <%= form.text_field :minister_name %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit "保存する", class: "button-primary" %>
    <%= link_to "キャンセル", ceremony_schedules_path(event_id: @selected_event.id), class: "button-secondary" %>
  </div>
<% end %>
