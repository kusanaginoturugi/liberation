<% if ceremony_schedule.errors.any? %>
  <div class="flash flash-alert">
    <strong>保存できませんでした</strong>
    <ul>
      <% ceremony_schedule.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: ceremony_schedule, class: "report-form" do |form| %>
  <div class="field-grid">
    <div class="field">
      <%= form.label :fellowship_id, "伝道会名" %>
      <% if current_user.admin? %>
        <%= form.collection_select :fellowship_id, @fellowships, :id, :name, { prompt: "選択してください" }, { required: true } %>
      <% elsif current_user.fellowship.present? %>
        <p class="readonly-field"><%= current_user.fellowship.name %></p>
      <% else %>
        <p class="readonly-field">未設定</p>
      <% end %>
    </div>

    <div class="field">
      <%= form.label :ceremony_at, "挙行日時" %>
      <%= form.datetime_local_field :ceremony_at, required: true %>
    </div>

    <div class="field">
      <%= form.label :place, "場所" %>
      <%= form.text_field :place, required: true %>
    </div>

    <div class="field">
      <%= form.label :assistant_count, "引保師数" %>
      <%= form.number_field :assistant_count, min: 0, required: true, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true } %>
    </div>

    <div class="field">
      <%= form.label :spirit_count, "霊数" %>
      <%= form.number_field :spirit_count, min: 0, required: true, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true } %>
    </div>

    <div class="field">
      <%= form.label :minister_name, "超抜点伝師" %>
      <%= form.text_field :minister_name, required: true %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit "保存する", class: "button-primary" %>
    <%= link_to "キャンセル", ceremony_schedules_path, class: "button-secondary" %>
  </div>
<% end %>
