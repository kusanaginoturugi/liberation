<% content_for :title, "超抜式追加" %>

<div class="page-shell auth-shell">
  <section class="panel form-panel auth-panel">
    <div class="panel-header">
      <h1>超抜式追加</h1>
      <%= link_to "戻る", root_path, class: "button-secondary compact-button" %>
    </div>

    <% if @event.errors.any? %>
      <div class="flash flash-alert">
        <strong>追加できませんでした</strong>
        <ul>
          <% @event.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @event, class: "report-form" do |form| %>
      <div class="field-grid">
        <div class="field">
          <%= form.label :name, "超抜式名" %>
          <%= form.text_field :name, required: true, autofocus: true %>
        </div>

        <% if single_region_mode? %>
          <div class="field">
            <%= form.label :total_serial_count, "合格霊数" %>
            <%= number_field_tag "event[total_serial_count]", @total_serial_count_input, min: 1, required: true, inputmode: "numeric", pattern: "[0-9]*", data: { numeric_only: true } %>
          </div>
        <% end %>

        <div class="field">
          <%= form.label :judgment_ceremony_on, "修霊超度審判式日" %>
          <%= form.date_field :judgment_ceremony_on %>
        </div>

        <div class="field">
          <%= form.label :chobatsu_starts_on, "超抜期間（開始）" %>
          <%= form.date_field :chobatsu_starts_on %>
        </div>

        <div class="field">
          <%= form.label :chobatsu_ends_on, "超抜期間（終了）" %>
          <%= form.date_field :chobatsu_ends_on %>
        </div>
      </div>

      <div class="actions">
        <%= form.submit "追加する", class: "button-primary" %>
      </div>
    <% end %>
  </section>
</div>
